{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-kitchen",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  // 公開先（独自ドメインだけ。workers.dev とプレビューの URL は閉じる）
  "routes": [{ "pattern": "ai-kitchen.plglab.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "RANKING_OFF": "0" },
  // 集計に届く前の連打止め（接続元ごとに 1 分 5 回）
  // 全体の入口の上限（拠点ごとに 1 分 3000 回）
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "TOTAL_LIMIT", "namespace_id": "1002", "simple": { "limit": 3000, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RANKING", "class_name": "Ranking" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ranking"] }]
}
